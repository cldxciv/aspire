# Copy to .env.local and fill in. Never commit real values.

# Public base URL used for canonical/OG/sitemap URLs.
NEXT_PUBLIC_SITE_URL=https://aspireiit.in

# Preview access gate (D-027). When set, every page and API asks for this password
# (HTTP Basic auth; any username). Use it for any shared preview that shows placeholder
# content. Leave empty for a public production launch. Never commit the real value.
PREVIEW_ACCESS_PASSWORD=

# Number of reverse proxies in front of the app that append to X-Forwarded-For (default 1).
# The sign-in and enquiry rate limits use the address added by the outermost trusted proxy;
# anything further left in the header is client-supplied and ignored. 2 = CDN + proxy, etc.
TRUSTED_PROXY_HOPS=

# Placeholder (DEMO) content. Defaults: shown in development, hidden in production.
# Set to "true" only for client-review deployments — the site is then noindexed.
SHOW_PLACEHOLDER_CONTENT=

# --- Enquiries (POST /api/enquiries) ---
# Destination for validated enquiries. "none" (default) = validate only, nothing is sent or stored.
ENQUIRY_DESTINATION=none
# Required when ENQUIRY_DESTINATION=webhook. Server-side only.
# URL must be https in production. Secret: at least 16 characters (e.g. `openssl rand -hex 32`);
# used to sign each delivery with the X-Aspire-Signature-256 header (see docs/api.md).
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_SECRET=

# --- Portals (/student, /parent, /admin) ---
# Preview shells (no data) are shown in development to signed-out visitors; set "false" to
# redirect them to /login instead. Signed-in users always get their real portal.
PORTAL_PREVIEW=

# --- Sign-in (D-029; docs/auth-and-portals.md) ---
# SQLite file holding accounts, sessions, parent links and the audit log. Default:
# .data/aspire.sqlite (git-ignored). Use an absolute path on a persistent disk in production.
# Single server only: several app instances need a managed database instead.
AUTH_DB_PATH=
# Only for a non-interactive `npm run auth:create-admin` (first admin on a new server).
# Set them for that one command in the shell, never in a committed file; the admin must
# change this password at first sign-in. Leave empty here.
AUTH_ADMIN_LOGIN_ID=
AUTH_ADMIN_NAME=
AUTH_ADMIN_PASSWORD=
