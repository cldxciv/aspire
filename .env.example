# Copy to .env.local and fill in. Never commit real values.

# Public base URL used for canonical/OG/sitemap URLs.
NEXT_PUBLIC_SITE_URL=https://aspireiit.in

# Placeholder (DEMO) content. Defaults: shown in development, hidden in production.
# Set to "true" only for client-review deployments — the site is then noindexed.
SHOW_PLACEHOLDER_CONTENT=

# --- Enquiries (POST /api/enquiries) ---
# Destination for validated enquiries. "none" (default) = validate only, nothing is sent or stored.
ENQUIRY_DESTINATION=none
# Required when ENQUIRY_DESTINATION=webhook. Server-side only.
# URL must be https in production. Secret: at least 16 characters (e.g. `openssl rand -hex 32`);
# used to sign each delivery with the X-Aspire-Signature-256 header (see docs/api.md).
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_SECRET=

# --- Portals (/student, /parent, /admin) ---
# No identity provider is integrated yet; all portal data APIs deny access.
# Preview shells (no data) are shown in development; set "false" to redirect to /login instead.
PORTAL_PREVIEW=
